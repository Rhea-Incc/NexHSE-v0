{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "customConditions": ["workspace"]
  },
  "include": ["./**/*.ts", "../lib/api/**/*.ts"]
}
