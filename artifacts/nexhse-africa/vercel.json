{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/robots.txt", "has": [{ "type": "host", "value": "admin.nexhse.co.ke" }], "destination": "/admin-robots.txt" },
    { "source": "/((?!assets/|api/|robots.txt|sitemap.xml|llms.txt|site.webmanifest|storage-bridge.html|favicon.svg|logo.png).*)", "destination": "/index.html" }
  ]
}
